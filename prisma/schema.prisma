
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  USER
  REQUESTER
  INVESTIGATOR
  ADMIN
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  password        String
  name            String
  phone           String?
  roles           Roles[]       @default([USER])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}